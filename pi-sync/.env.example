# Pi PostgreSQL source
PI_DSN=postgresql://postgres:postgres@postgres:5432/eh_stash

# Neon PostgreSQL target
NEON_DSN=postgresql://USER:PASS@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 thumbnail storage
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=eh-stash-thumbs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
THUMB_DIR=/data/thumbs

# Sync scheduling and batch sizes
SYNC_CADENCE_SEC=21600
SYNC_CHUNK_ROT=5000
SYNC_OUTBOX_BATCH=2000

# Set to 1 to run one cycle and exit.
# SYNC_ONESHOT=1
