DB_USER=postgres
DB_PASSWORD=postgres

# ─── Production image versions ──────────────────────────────────────────────
REGISTRY_URL=192.168.0.110:5000
API_TAG=latest
SCRAPER_TAG=latest
FRONTEND_TAG=latest
PI_SYNC_TAG=latest

EX_COOKIES=ipb_member_id=YOUR_ID;ipb_pass_hash=YOUR_HASH;sk=YOUR_SK
EX_BASE_URL=https://exhentai.org
# EX_BASE_URL=https://e-hentai.org
RATE_INTERVAL=2.0
THUMB_RATE_INTERVAL=0.5
THUMB_WORKERS=1
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/eh_stash
TAG_BLACKLIST=male:yaoi,female:amputee,female:futanari
# PROXY_URL=http://user:pass@host:port

# ─── pi-sync (Pi → R2 thumbnail upload) ────────────────────────────────────
# R2 — generate a Pi-scoped token (Object Read+Write on the thumb bucket)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=eh-stash-thumbs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cadence: 300=5min (initial), bump to 1800=30min once caught up
SYNC_CADENCE_SEC=300
SYNC_HEARTBEAT_SEC=60
SYNC_CHUNK_ROT=5000
SYNC_OUTBOX_BATCH=500
# /healthz liveness port (Uptime Kuma + deploy verify)
SYNC_HEALTH_PORT=8097

# ─── Frontend build ─────────────────────────────────────────────────────────
# VITE_THUMB_BASE_URL: R2 public origin for thumbnails. When set, the
# frontend fetches thumbs directly from R2 and pi-sync deletes local thumb
# files after a successful R2 upload.
# Empty (dev) ⇒ frontend falls back to same-origin /v1/thumbs/{gid}.
# The deploy workflow sources this from the stack .env at build time.
VITE_THUMB_BASE_URL=https://pub-<hash>.r2.dev
